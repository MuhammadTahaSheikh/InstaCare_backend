# Optional local overrides. DB credentials come from .env (Hostinger).
# If port 5001 is in use, change to 5002 (only one backend per port)
PORT=5001

# Frontend URL for email verification links
FRONTEND_URL=http://localhost:3000

# SMTP (optional in dev — verification link is logged to console if unset)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=BestechCare <noreply@bestechcare.pk>

# To use local MySQL instead of Hostinger, uncomment:
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=bestechcare
