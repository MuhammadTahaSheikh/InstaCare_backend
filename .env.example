# Use 5001 locally — macOS AirPlay uses 5000
PORT=5001
# After copying: also run `cp .env.local.example .env.local` for local MySQL (root/bestechcare)
# Local dev: localhost | Hostinger (on server): localhost | Hostinger (remote): hostname from hPanel
DB_HOST=localhost
DB_USER=u916710688_instacare
DB_PASSWORD=your_password
DB_NAME=u916710688_instacare
JWT_SECRET=your_super_secret_jwt_key_change_this

# Email verification (required in production)
FRONTEND_URL=https://bestech-care.vercel.app

# SMTP — see backend/DEPLOY.md for Hostinger / Resend / Gmail setup
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@bestechcare.pk
SMTP_PASS=your_email_password
SMTP_FROM=BestechCare <hello@bestechcare.pk>

# AI Doctor — Groq API for ChatGPT-like dynamic replies (FREE at https://console.groq.com)
# Add this key on the VPS backend/.env and restart PM2 for full AI conversations:
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# AI Doctor — Python bot (default, no API key required)
# AI_DOCTOR_BOT_URL=http://127.0.0.1:5003
# AI_DOCTOR_BOT_PORT=5003

# AI Doctor — optional OpenAI fallback (if Python bot is down)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# AI Doctor — optional local LLM via Ollama (enhanced responses, still no OpenAI key)
# AI_DOCTOR_USE_OLLAMA=true
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# n8n — AI Doctor consultation complete workflow (optional)
# N8N_AI_DOCTOR_WEBHOOK_URL=https://your-n8n.app/webhook/ai-doctor-complete

# n8n — appointment reminder workflow (optional)
# Create a Webhook node in n8n and paste its URL here.
# N8N_APPOINTMENT_WEBHOOK_URL=https://your-n8n.app/webhook/appointment-notifications
# Shared secret for n8n to call GET /api/appointments/:id/reminder-status
# N8N_WEBHOOK_SECRET=generate_a_long_random_string

# Payment gateways
# JazzCash — get sandbox credentials at https://sandbox.jazzcash.com.pk
# Leave unset to use demo OTP mode (123456)
# JAZZCASH_ENV=sandbox
# JAZZCASH_MERCHANT_ID=
# JAZZCASH_PASSWORD=
# JAZZCASH_INTEGRITY_SALT=
# JAZZCASH_RETURN_URL=https://your-api.com/api/payments/jazzcash/callback
# JAZZCASH_DEFAULT_CNIC=345678
# BACKEND_URL=https://your-api.com
# EASYPAISA_STORE_ID=
# EASYPAISA_HASH_KEY=

# SMS OTP (Twilio) — sends OTP to the wallet phone number on payment
# Sign up at https://www.twilio.com — trial can send to verified numbers only
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+15005550006
